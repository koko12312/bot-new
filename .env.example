# --- BOT CREDENTIALS ---
TELEGRAM_TOKEN=your_telegram_bot_token_here
BOT_USERNAME=@YourBotUsername
ADMIN_ID=your_telegram_user_id

# --- TEXTVERIFIED API ---
TEXTVERIFIED_API_KEY=your_textverified_api_key
TEXTVERIFIED_USERNAME=your_textverified_email@example.com

# --- PVADEALS API ---
PVADEALS_API_KEY=your_pvadeals_api_key
PVADEALS_BASE_URL=https://prod-v3.pvadeals.com/v3/api
PVADEALS_PRICE=7.00

# --- NOWPAYMENTS API (CRYPTO) ---
NOWPAYMENTS_API_KEY=your_nowpayments_api_key
NOWPAYMENTS_IPN_SECRET=your_nowpayments_ipn_secret
USE_SANDBOX=false
IPN_CALLBACK_URL=https://your-domain.com/webhook/nowpayments

# --- ADJUSTABLE SETTINGS ---
SERVICE_PRICE=12.00
REFERRAL_BONUS=2.00
SMS_POLL_ATTEMPTS=10
SMS_POLL_DELAY=6

# --- SHAMCASH CONFIG ---
SHAMCASH_ID=your_shamcash_id
SHAMCASH_QR_PATH=ShamQR.jpeg

# --- WEBHOOK CONFIG (Optional) ---
USE_WEBHOOK=false
TELEGRAM_WEBHOOK_URL=https://your-domain.com/webhook/telegram

